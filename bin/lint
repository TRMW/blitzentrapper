#!/usr/bin/env ruby
# frozen_string_literal: true

# Lints the whole repo: RuboCop (Rails' omakase config, see .rubocop.yml) for
# Ruby, and ESLint (see eslint.config.mjs) for the JavaScript/React code.
#
#   bin/lint         report offenses; exits 1 if there are any
#   bin/lint --fix   autocorrect what can be fixed safely, then report the rest
#
# CI runs the same command (.github/workflows/lint.yml).

require "open3"

Dir.chdir(File.expand_path("..", __dir__))
fix = ARGV.include?("--fix")

# Prefer the bundled RuboCop. When the bundle can't load (for example a local
# Ruby that differs from the Gemfile's pinned version), install and run the
# same versions from Gemfile.lock as standalone gems.
def rubocop_command
  _, status = Open3.capture2e("bundle", "exec", "rubocop", "--version")
  return %w[bundle exec rubocop] if status.success?

  lock = File.read("Gemfile.lock")
  gems = %w[rubocop rubocop-rails-omakase rubocop-rails rubocop-performance]
  gems.each do |name|
    version = lock[/^    #{Regexp.escape(name)} \(([\d.]+)\)$/, 1]
    abort "#{name} is missing from Gemfile.lock" unless version
    next if system("gem", "list", "-i", name, "-v", version, out: File::NULL)

    warn "Installing #{name} #{version} (bundle unavailable)..."
    system("gem", "install", name, "-v", version, "--no-document", exception: true)
  end
  [ "rubocop", "_#{lock[/^    rubocop \(([\d.]+)\)$/, 1]}_" ]
end

def eslint_command
  unless File.exist?("node_modules/.bin/eslint")
    warn "Installing JS dependencies (yarn install)..."
    system("yarn", "install", "--frozen-lockfile", exception: true)
  end
  [ "node_modules/.bin/eslint" ]
end

puts "== RuboCop"
rubocop_ok = system(*rubocop_command, *(fix ? [ "-a" ] : []))
puts "\n== ESLint"
eslint_ok = system(*eslint_command, ".", *(fix ? [ "--fix" ] : []))
puts "ESLint: no offenses" if eslint_ok

exit(rubocop_ok && eslint_ok ? 0 : 1)
