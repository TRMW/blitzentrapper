<% title "Traffic" %>

<div class="traffic">
  <h1>Where traffic comes from</h1>

  <nav class="traffic-periods">
    <% TrafficController::PERIODS.each do |days| %>
      <% if days == @period %>
        <strong>Last <%= days %> days</strong>
      <% else %>
        <%= link_to "Last #{days} days", traffic_path(days: days) %>
      <% end %>
    <% end %>
  </nav>

  <div class="traffic-tiles">
    <div class="traffic-tile">
      <div class="traffic-tile__value"><%= number_with_delimiter(@arrivals) %></div>
      <div class="traffic-tile__label">visits from people</div>
      <% if @previous_arrivals.positive? %>
        <% change = ((@arrivals - @previous_arrivals) * 100.0 / @previous_arrivals).round %>
        <div class="traffic-tile__meta"><%= change >= 0 ? "+#{change}" : change %>% vs the <%= @period %> days before</div>
      <% end %>
    </div>
    <div class="traffic-tile">
      <div class="traffic-tile__value"><%= number_with_delimiter(@person_views) %></div>
      <div class="traffic-tile__label">pages viewed by people</div>
    </div>
    <div class="traffic-tile">
      <div class="traffic-tile__value"><%= number_with_delimiter(@bot_views) %></div>
      <div class="traffic-tile__label">pages fetched by crawlers</div>
      <% total = @person_views + @bot_views %>
      <% if total.positive? %>
        <div class="traffic-tile__meta"><%= (@bot_views * 100.0 / total).round %>% of all page loads</div>
      <% end %>
    </div>
  </div>

  <section class="traffic-panel">
    <h2>Visits from people per day</h2>
    <% top = [ @daily_arrivals.values.max.to_i, 1 ].max %>
    <div class="traffic-chart" role="img" aria-label="Visits from people per day">
      <% @days.each do |day| %>
        <% visits = @daily_arrivals[day].to_i %>
        <div class="traffic-chart__day" title="<%= day.strftime("%a %b %-d") %>: <%= visits %> visits, <%= @daily_people[day].to_i %> pages viewed">
          <div class="traffic-chart__bar" style="height: <%= (visits * 100.0 / top).round(1) %>%"></div>
        </div>
      <% end %>
    </div>
    <div class="traffic-chart__axis">
      <span><%= @days.first.strftime("%b %-d") %></span>
      <span><%= @days.last.strftime("%b %-d") %></span>
    </div>
  </section>

  <div class="traffic-grid">
    <section class="traffic-panel">
      <h2>How people arrived</h2>
      <table class="traffic-table">
        <% @sources.each do |source, count| %>
          <tr>
            <td class="traffic-table__label">
              <%= source %>
              <span class="traffic-table__bar" style="width: <%= (count * 100.0 / @sources.first.last).round(1) %>%"></span>
            </td>
            <td class="traffic-table__count"><%= number_with_delimiter(count) %></td>
            <td class="traffic-table__share"><%= number_to_percentage(count * 100.0 / @arrivals, precision: 0) %></td>
          </tr>
        <% end %>
      </table>
      <% if @previous_sources.any? %>
        <p class="traffic-note">
          The <%= @period %> days before:
          <%= @previous_sources.map { |source, count| "#{source} #{number_with_delimiter(count)}" }.join(", ") %>
        </p>
      <% end %>
      <% if @sources.empty? %><p class="traffic-empty">Nothing yet.</p><% end %>
    </section>

    <%= render "table", heading: "Referring sites", rows: @referrers, total: @arrivals %>
    <%= render "table", heading: "Referring links", rows: @referrer_links, total: @arrivals,
          labeler: ->(link) { link_to link, "https://#{link}", rel: "noreferrer noopener", target: "_blank" } %>
    <%= render "table", heading: "Search terms", rows: @search_terms, total: @search_arrivals,
          empty: "None yet. Bing and Yahoo sometimes pass these along; Google never does.",
          footer: link_to("Google search terms are in Search Console →", TrafficController::SEARCH_CONSOLE_URL, target: "_blank", rel: "noopener") %>
    <%= render "table", heading: "Countries", rows: @countries, total: @arrivals,
          labeler: ->(code) { code == "Unknown" ? code : content_tag(:span, code, data: { region: code }) } %>
    <%= render "table", heading: "Landing pages", rows: @landing_pages, total: @arrivals,
          labeler: ->(path) { link_to path, path } %>
    <%= render "table", heading: "Most viewed pages", rows: @pages, total: @person_views,
          labeler: ->(path) { link_to path, path } %>
    <%= render "table", heading: "Crawlers and bots (page loads)", rows: @bots, total: @bot_views %>
  </div>

  <h2 class="traffic-section">Pages not found (404)</h2>
  <p class="traffic-note">
    <%= number_with_delimiter(@not_found_total) %> requests for pages that don't exist.
    Broken links are the ones worth fixing: they show the page or site that linked to a missing page.
  </p>
  <div class="traffic-grid">
    <%= render "table", heading: "Broken links (where from → missing page)", rows: @not_found_links, total: @not_found_total %>
    <%= render "table", heading: "Who asked", rows: @not_found_agents, total: @not_found_total %>
    <%= render "table", heading: "Missing pages people asked for", rows: @not_found_pages, total: @not_found_total %>
    <%= render "table", heading: "Missing pages crawlers asked for", rows: @not_found_bot_pages, total: @not_found_total %>
  </div>

  <p class="traffic-note">
    A visit is a person arriving from outside the site (or typing the address);
    clicks between pages count as pages viewed. Referring links show the page
    that linked here when the other site shares it; most only share their
    domain. Search terms only appear when the search engine passes them along,
    which Google never does; Google's are in
    <%= link_to "Search Console", TrafficController::SEARCH_CONSOLE_URL, target: "_blank", rel: "noopener" %>. No IP addresses are stored. "Hidden bots" send a normal browser name but come from a cloud
    server, claim a years-old browser, or leave out headers every browser sends;
    they're counted as crawlers. Counting started on <%= TrafficCount.minimum(:day)&.strftime("%b %-d, %Y") || "today" %>.
    <a href="https://db-ip.com">IP Geolocation by DB-IP</a>.
  </p>
</div>

<script>
  // Show country names ("United States") instead of the stored codes ("US").
  try {
    var names = new Intl.DisplayNames(["en"], { type: "region" });
    document.querySelectorAll("[data-region]").forEach(function (el) {
      el.textContent = names.of(el.dataset.region) + " (" + el.dataset.region + ")";
    });
  } catch (e) {}
</script>
